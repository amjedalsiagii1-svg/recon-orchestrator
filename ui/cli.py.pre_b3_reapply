    def _load_scope(self) -> None:
        try:
            self.scope = Scope()
            self.console.print(f"[green]Scope loaded:[/green] {self.scope!r}")
        except Exception as e:
            self.console.print(f"[red]Scope error:[/red] {e}")
            self.scope = None

    async def _open_session(self) -> None:
        try:
            self.session = await Session.open("data/sessions.db")
            if self._resume_id:
                row = await self.session.get(self._resume_id)
                if not row:
                    self.console.print(
                        f"[red]Session not found:[/red] {self._resume_id}"
                    )
                    self._resume_id = None
                else:
                    self.session.id = self._resume_id
                    # Load stored target so P3/P4/P5 reuse it
                    if row.get("target"):
                        self.target = row["target"]
                    self.console.print(
                        f"[green]Resumed session:[/green] {self._resume_id}"
                        + (f"  target={self.target}" if self.target else "")
                    )
            if not self.session.id:
                sid = await self.session.create("cli-session")
                self.console.print(f"[green]Session:[/green] {sid}")
        except Exception as e:
            self.console.print(f"[red]Session error:[/red] {e}")

    def _status(self) -> None:
        priv = detect_priv()
        t = Table.grid(padding=(0, 2))
        t.add_column(style="bold")
        t.add_column()
        t.add_row("الهدف / Target:", self.target or "[dim](غير محدد / unset)[/dim]")
        t.add_row("الجلسة / Session:", self.session.id if self.session else "[red]لا يوجد / none[/red]")
        try:
            from core import platform as _plat
            _plat_label = _plat.get().label
        except Exception:
            _plat_label = "Unknown"
        t.add_row("المنصة / Platform:", _plat_label)
        t.add_row("الصلاحيات / Privilege:", priv.summary)
        t.add_row("وضع العرض / Demo:", "yes" if self.demo else "no")
        self.console.print(Panel(t, title="Status", border_style="blue"))

    # ---------- main loop ----------
    async def _main_loop(self) -> None:
        while True:
            self._menu()
            try:
                choice = input("\nاختر / choose > ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                self.console.print("\n[dim]bye[/dim]")
                break
            if not choice:
                continue
            if choice in ("q", "quit", "exit"):
                break
            if choice in ("h", "help", "?"):
                self._help()
                continue
            if choice in ("r", "refresh", "status"):
                self._status()
                continue
            if choice in ("s", "scope"):
                self._show_scope()
                continue
            if choice in ("p", "platform"):
                await self._show_platform_detail()
                continue
            if choice in ("l", "ls", "sessions"):
                await self._list_sessions()
                continue
            if choice in ("t", "target"):
                self._set_target_interactive()
                continue
            if choice.isdigit() and 1 <= int(choice) <= 7:
                await self._run_phase(int(choice))
                continue
            self.console.print("[yellow]Unknown choice. Press H for help.[/yellow]")
        await self._close()

    def _menu(self) -> None:
        table = Table(title="المراحل السبع / Seven Phases", show_lines=False, border_style="cyan")
        table.add_column("#", style="bold cyan", width=3)
        table.add_column("المرحلة / Phase", style="bold")
        table.add_column("Description", style="dim")
        for i, (pid, name, desc) in enumerate(PHASES, start=1):
            ar_name = PHASE_AR.get(pid, "")
            display = f"{ar_name}\n{name}" if ar_name else name
            table.add_row(str(i), display, desc)
        self.console.print(table)
        self.console.print(
            "[dim]Commands:[/dim] [bold]1-7[/bold] run phase  •  "
            "[bold]t[/bold] target  •  [bold]s[/bold] scope  •  "
            "[bold]r[/bold] status  •  [bold]l[/bold] sessions  •  [bold]h[/bold] help  •  [bold]q[/bold] quit"
        )

    def _help(self) -> None:
        self.console.print(
            Panel(
                "[bold]How to use[/bold]\n"
                "• Type a number 1-7 and press Enter to open that phase.\n"
                "• Type [bold]t[/bold] to set the target (must be in scope.txt).\n"
                "• Type [bold]s[/bold] to view the loaded scope.\n"
                "• Type [bold]r[/bold] to refresh status.\n"
                "• Type [bold]q[/bold] to quit.\n\n"
                "[dim]On Termux, this CLI works with the normal on-screen keyboard.\n"
                "If you prefer the Textual TUI, use a hardware keyboard or SSH.[/dim]",
                title="Help",
                border_style="green",
            )
        )

    def _show_scope(self) -> None:
        if not self.scope:
            self.console.print("[red]No scope loaded[/red]")
            return
        try:
            raw = self.scope.path.read_text(encoding="utf-8")
        except Exception as e:
            self.console.print(f"[red]Cannot read scope: {e}[/red]")
            return
        self.console.print(Panel(raw, title=str(self.scope.path), border_style="green"))

    def _set_target_interactive(self) -> None:
        try:
            val = input("Target (IP/CIDR/hostname): ").strip()
        except (EOFError, KeyboardInterrupt):
            return
        if not val:
            return
        if self.scope and not self.scope.is_allowed(val):
            self.console.print(f"[red]REJECTED:[/red] '{val}' is not in scope.txt")
            return
        self.target = val
        if self.session:
            try:
                import asyncio
                asyncio.get_event_loop().create_task(self.session.set_target(val))
            except Exception:
                pass
        self.console.print(f"[green]Target set:[/green] {val}")

    async def _run_phase(self, n: int) -> None:
        pid, name, _ = PHASES[n - 1]
        self.console.print(f"\n[bold cyan]→ Phase {n}: {name}[/bold cyan]")

        if self.demo:
            self.console.print("[yellow]Demo mode — phase not executed.[/yellow]")
            return

        try:
            if n == 1:
                await self._phase1()
            elif n == 2:
                await self._phase2()
            elif n == 3:
                await self._phase3()
            elif n == 4:
                await self._phase4()
            elif n == 5:
                await self._phase5()
            elif n == 6:
                await self._phase6()
            elif n == 7:
                await self._phase7()
            else:
                self.console.print(
                    f"[yellow]Phase {n} not wired yet.[/yellow] "
                    "[dim]Coming in next steps.[/dim]"
                )
        except Exception as e:
            self.console.print(f"[red]Error:[/red] {e}")

    async def _phase1(self) -> None:
        """Run network type detection (real)."""
        from phases.p1_network_type import detect as detect_p1
        self.console.print("[bold cyan]المرحلة 1 — كشف نوع الشبكة[/bold cyan]")
        self.console.print("[dim]Phase 1 — Network Type Detection[/dim]")
        self.console.print()
        self.console.print("[bold cyan]جارٍ الفحص (حد أقصى 5 ثوانٍ)...[/bold cyan]")
        self.console.print("[dim]Running probes... (max 5s)[/dim]")
        result = await detect_p1(timeout=3.0)

        net = result.network
        cap = result.captive
        tls = result.tls
        cls = result.classification

        # Network info table
        info = Table(title="Network Info", border_style="cyan", show_header=False)
        info.add_column("Key", style="bold")
        info.add_column("Value")
        info.add_row("Local IPs", ", ".join(net.local_ips) or "(none)")
        info.add_row("Gateway", net.default_gateway or "(unknown)")
        info.add_row("Interface", net.default_iface or "(unknown)")
        self.console.print(info)

        # Probes table
        probes = Table(title="Probes", border_style="cyan", show_header=True)
        probes.add_column("Check")
        probes.add_column("Result")
        probes.add_row(
            "Captive portal",
            f"status={cap.status} redirect={cap.redirected}"
            + (f" loc={cap.location}" if cap.location else "")
            + (f" err={cap.error}" if cap.error else ""),
        )
        probes.add_row(
            "TLS issuer",
            (tls.issuer_cn or tls.error or "unknown")
            + (" [red](suspicious)[/red]" if tls.is_suspicious else ""),
        )
        probes.add_row("DNS", "OK" if result.dns_ok else "[red]FAIL[/red]")
        self.console.print(probes)

        # Classification
        color = {
            "hotspot": "yellow",
            "commercial": "magenta",
            "home_router": "green",
            "unknown": "white",
        }.get(cls.type, "white")
        self.console.print(
            Panel(
                f"[bold cyan]النوع:[/bold cyan] {cls.type}\n"
                f"Type: {cls.type}\n\n"
                f"[bold cyan]الثقة:[/bold cyan] {cls.confidence}\n"
                f"Confidence: {cls.confidence}\n\n"
                f"[bold cyan]الأسباب:[/bold cyan]\n  • "
                + "\n  • ".join(cls.reasons or ["(none)"]),
                title="التصنيف / Classification",
                border_style=color,
            )
        )

        # Persist to session
        if self.session:
            try:
                await self.session.set_phase("p1", result.to_dict())
                await self.session.log_event(
                    "p1", "info", f"classification={cls.type}", result.to_dict()
                )
                self.console.print("[dim]تم الحفظ في الجلسة / Saved to session[/dim]")
            except Exception as e:
                self.console.print(f"[yellow]Save failed: {e}[/yellow]")

    async def _phase2(self) -> None:
        """Discovery — scan local subnet, enumerate devices."""
        import json
        from phases.p2_discovery import discover
        self.console.print("[bold cyan]المرحلة 2 — اكتشاف الأجهزة على الشبكة[/bold cyan]")
        self.console.print("[dim]Phase 2 — Discovery[/dim]")
        self.console.print()
        from phases.p1_network_type import _local_ips, _read_proc_route

        # Determine subnet
        ips = _local_ips()
        if not ips:
            self.console.print("[red]No local IP detected[/red]")
            return
        try:
            parts = ips[0].split(".")
            subnet = ".".join(parts[:3] + ["0"]) + "/24"
        except Exception:
            self.console.print(f"[red]Cannot parse IP: {ips[0]}[/red]")
            return

        # Determine gateway (cached P1 or re-detect)
        gateway = None
        if self.session:
            p1 = await self.session.get_phase_data("p1")
            if p1:
                gateway = (p1.get("network") or {}).get("default_gateway")
        if not gateway:
            gateway, _iface = _read_proc_route()

        self.console.print(
            f"[bold cyan]جارٍ اكتشاف الأجهزة على {subnet} (بوابة {gateway}) — حد أقصى 90 ثانية[/bold cyan]"
        )
        self.console.print(
            f"[dim]Discovering {subnet} (gateway={gateway})... max 90s[/dim]"
        )

        result = await discover(subnet, scope=self.scope, gateway=gateway, timeout=90)

        if result.error:
            self.console.print(f"[red]Discovery error:[/red] {result.error}")
            if "authorized" in result.error.lower():
                self.console.print(
                    f"[yellow]Add your subnet to config/scope.txt first:\n"
                    f"  echo '{subnet}' >> config/scope.txt[/yellow]"
                )
            return

        # Table
        methods_str = ", ".join(getattr(result, "methods_used", []) or [])
        bcast = getattr(result, "broadcast_devices", 0)
        header = f"الأجهزة المكتشفة ({len(result.devices)})"
        if methods_str:
            header += f" — {methods_str}"
        if bcast > 0:
            header += f"  +{bcast} جديد"

        table = Table(
            title=header,
            border_style="cyan",
            show_header=True,
        )
        table.add_column("IP", style="bold")
        table.add_column("Source", style="dim")
        table.add_column("MAC")
        table.add_column("Vendor")
        table.add_column("Hostname")
        table.add_column("Type", style="cyan")
        table.add_column("Svc", justify="center", style="dim")

        for d in result.devices:
            marker = "→" if d.is_gateway else " "
            source = getattr(d, "source", "nmap") or "nmap"
            services = getattr(d, "services", []) or []
            svc_str = f"+{len(services)}" if services else "-"
            table.add_row(
                f"{marker} {d.ip}",
                source,
                d.mac or "-",
                d.vendor or "-",
                d.hostname or "-",
                d.device_type,
                svc_str,
            )
        self.console.print(table)
        self.console.print(
            f"[dim]المدة / Duration: {result.duration_seconds}s[/dim]"
        )

        # Save
        if self.session:
            try:
                await self.session.set_phase("p2", result.to_dict())
                await self.session.log_event(
                    "p2", "info", f"{len(result.devices)} devices discovered",
                    result.to_dict(),
                )
                self.console.print("[dim]تم الحفظ في الجلسة / Saved to session[/dim]")
            except Exception as e:
                self.console.print(f"[yellow]Save failed: {e}[/yellow]")


    async def _phase3(self) -> None:
        """Choose a target from discovered devices + re-verify scope."""
        self.console.print("[bold cyan]المرحلة 3 — اختيار الهدف[/bold cyan]")
        self.console.print("[dim]Phase 3 — Target Selection[/dim]")
        self.console.print()
        import json
        from phases.p3_target_select import select_target
        from core.scope import ScopeError

        if not self.session:
            self.console.print("[red]لا توجد جلسة نشطة / No active session[/red]")
            return
        p2 = await self.session.get_phase_data("p2")
        if not p2:
            self.console.print(
                "[yellow]لا توجد بيانات اكتشاف — شغّل المرحلة 2 أولًا / "
                "No discovery data — run Phase 2 first[/yellow]"
            )
            return
        devices = p2.get("devices") or []
        if not devices:
            self.console.print("[yellow]لم يُعثر على أجهزة / Discovery returned no devices[/yellow]")
            return

        table = Table(title="الأجهزة المكتشفة / Discovered devices", border_style="cyan")
        table.add_column("#", style="bold cyan", width=3)
        table.add_column("IP")
        table.add_column("Type")
        table.add_column("Hostname")
        table.add_column("Vendor")
        for i, d in enumerate(devices, start=1):
            table.add_row(
                str(i),
                d.get("ip", "-"),
                d.get("device_type", "unknown"),
                d.get("hostname") or "-",
                d.get("vendor") or "-",
            )
        self.console.print(table)

        try:
            raw = input("اختر الهدف (# أو IP، Enter للإلغاء) / Select target: ").strip()
        except (EOFError, KeyboardInterrupt):
            return
        if not raw:
            return

        if raw.isdigit():
            idx = int(raw)
            if not (1 <= idx <= len(devices)):
                self.console.print("[red]رقم غير صالح / Invalid index[/red]")
                return
            ip = devices[idx - 1].get("ip")
        else:
            ip = raw

        scope = self.scope or Scope()
        try:
            target = select_target(ip, devices, scope)
        except ScopeError as e:
            self.console.print(f"[red]مرفوض / REJECTED:[/red] {e}")
            return
        except ValueError as e:
            self.console.print(f"[red]غير صالح / Invalid:[/red] {e}")
            return

        self.console.print(
            Panel(
                f"[bold]{target.ip}[/bold]  ({target.device_type})"
                + ("  [yellow]← البوابة / GATEWAY[/yellow]" if target.is_gateway else "")
                + f"\n"
                f"MAC:      {target.mac or '-'}\n"
                f"Vendor:   {target.vendor or '-'}\n"
                f"Hostname: {target.hostname or '-'}\n"
                f"في النطاق / In scope: [green]نعم / yes[/green]\n\n"
                f"[bold cyan]الخطوات التالية / Recommended:[/bold cyan]\n"
                + "\n".join(f"  • {r}" for r in target.recommended_next),
                title="الهدف المختار / Target Selected",
                border_style="green",
            )
        )

        self.target = target.ip
        try:
            await self.session.set_target(target.ip)
            await self.session.set_phase("p3", target.to_dict())
            await self.session.log_event(
                "p3", "info", f"target={target.ip}", target.to_dict()
            )
            self.console.print("[dim]تم حفظ الهدف في الجلسة / Target saved[/dim]")
        except Exception as e:
            self.console.print(f"[yellow]Save failed: {e}[/yellow]")

    async def _phase4(self) -> None:
        """Port scan with profile selection + risk summary."""
        from phases.p4_port_scan import PROFILES, scan
        from core.scope import Scope
        self.console.print("[bold cyan]المرحلة 4 — فحص المنافذ[/bold cyan]")
        self.console.print("[dim]Phase 4 — Port Scan[/dim]")
        self.console.print()

        # --- 1) Determine target ---
