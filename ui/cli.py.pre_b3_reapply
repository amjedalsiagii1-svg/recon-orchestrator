    async def _phase7(self) -> None:
        """Generate HTML report with user-chosen filename + Downloads copy."""
        import shutil
        from pathlib import Path as _P
        from phases.p7_report import generate as generate_p7

        if not self.session:
            self.console.print("[red]No active session.[/red]")
            return

        p5 = await self.session.get_phase_data("p5")
        if not p5:
            self.console.print(
                "[yellow]No scan data. Run phases 2-5 at least once.[/yellow]"
            )
            try:
                cont = input("Generate report anyway? [y/N]: ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                return
            if cont != "y":
                return

        # 1) اسم التقرير
        default_name = f"recon-{self.session.id}.html"
        self.console.print(
            "\n[bold cyan]اختر اسم ملف التقرير[/bold cyan] "
            "[dim](مثال: my-router-scan.html)[/dim]"
        )
        self.console.print(
            "[dim]Choose report filename (e.g. my-router-scan.html)[/dim]"
        )
        self.console.print(f"[dim]Enter فقط = {default_name}[/dim]")
        try:
            raw = input("File name: ").strip()
        except (EOFError, KeyboardInterrupt):
            return
        filename = raw or default_name
        # sanitize: اجعلها .html فقط + أحرف آمنة
        base = filename[:-5] if filename.lower().endswith(".html") else filename
        base = "".join(c for c in base if c.isalnum() or c in " ._-()").strip()
        if not base:
            base = default_name[:-5]
        filename = base + ".html"

        # 2) توليد في reports/output/
        self.console.print(f"[bold cyan]جارٍ توليد: {filename}[/bold cyan]")
        self.console.print(f"[dim]Generating: {filename}...[/dim]")
        try:
            result = await generate_p7(self.session, filename=filename)
        except Exception as e:
            self.console.print(f"[red]Report generation failed:[/red] {e}")
            return

        if not result.get("ok"):
            self.console.print(f"[red]Error:[/red] {result.get('error')}")
            return

        report_path = result["path"]
        size_kb = result["size_bytes"] / 1024

        # 3) نسخ إلى Downloads (للوصول من متصفح الجوال)
        downloads_dst = None
        downloads_dir = _P("/storage/emulated/0/Download")
        if downloads_dir.is_dir():
            try:
                dst = downloads_dir / filename
                shutil.copy(report_path, dst)
                downloads_dst = str(dst)
            except Exception as e:
                self.console.print(f"[yellow]نسخ إلى Downloads فشل: {e}[/yellow]")
        else:
            self.console.print(
                "[yellow]Downloads غير متاح.[/yellow] نفّذ أولًا: "
                "[bold]termux-setup-storage[/bold] (اسمح بالوصول)"
            )

        # 4) عرض النتيجة
        body = (
            f"[bold green]\u2713 تم توليد التقرير[/bold green]\n\n"
            f"الاسم:    [cyan]{filename}[/cyan]\n"
            f"الحجم:    {size_kb:.1f} KB\n"
            f"الصيغة:   HTML (مستقل، ثيم داكن)\n\n"
            f"[bold]النسخة الداخلية:[/bold]\n"
            f"  {report_path}\n"
        )
        if downloads_dst:
            body += (
                f"\n[bold]نسخة في التنزيلات (لفتحها من المتصفح):[/bold]\n"
                f"  [yellow]{downloads_dst}[/yellow]\n"
                f"\n[dim]افتح تطبيق Files \u2192 Downloads \u2192 {filename}[/dim]\n"
                f"[dim]أو: termux-open --content-type text/html '{downloads_dst}'[/dim]"
            )
        else:
            body += (
                f"\n[bold]فتح التقرير:[/bold]\n"
                f"  termux-open --content-type text/html '{report_path}'\n"
                f"[dim]أو انسخه يدويًا إلى /storage/emulated/0/Download/[/dim]"
            )

        self.console.print(
            Panel(body, title="التقرير جاهز / Report Ready", border_style="green")
        )

        # 5) حفظ في الجلسة
        try:
            await self.session.set_phase("p7", {
                **result,
                "downloads_path": downloads_dst,
            })
            await self.session.log_event(
                "p7", "info",
                f"report: {filename} ({size_kb:.1f} KB)",
                {"path": report_path, "downloads": downloads_dst},
            )
        except Exception:
            pass

