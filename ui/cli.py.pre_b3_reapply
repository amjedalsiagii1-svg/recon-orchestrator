        if self.session:
            try:
                await self.session.close()
            except Exception:
                pass
        self.console.print("[dim]Session closed. Goodbye.[/dim]")


def main(demo: bool = False, resume: str | None = None) -> None:
    import asyncio
    try:
        asyncio.run(CLI(demo=demo, session_id=resume).start())
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    import argparse
    p = argparse.ArgumentParser()
    p.add_argument("--demo", action="store_true")
    p.add_argument("--resume", metavar="SESSION_ID", default=None,
                   help="Resume an existing session")
    a = p.parse_args()
    main(demo=a.demo, resume=a.resume)
