        _row("UDP scan (-sU)", caps.udp_scan, "requires root/sudo")
        _row("OS detection (-O)", caps.os_detection, "requires root/sudo")
        _row("ARP scan", caps.arp_scan, "requires root + arp-scan")
        _row("Packet capture", caps.packet_capture, "requires root + tcpdump")
        _row("nuclei", caps.nuclei, "")
        _row("searchsploit", caps.searchsploit, "Kali only usually")
        _row("msfconsole", caps.msfconsole, "Kali only usually")
        _row("Textual TUI", caps.textual_tui, "Kali only (BiDi)")
        _row("PDF reports", caps.pdf, "requires weasyprint")
        _row("Web UI (Flask)", caps.web, "always")
