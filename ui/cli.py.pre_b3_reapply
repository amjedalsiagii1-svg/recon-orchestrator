                    "[yellow]⚠ لفتح كل القدرات (SYN, UDP, OS): استخدم Kali Linux[/yellow]"
                )
                self.console.print(
                    "[dim]⚠ To unlock all (SYN, UDP, OS): use Kali Linux[/dim]"
                )
            self.console.print()
        except Exception:
            pass

    async def _show_platform_detail(self) -> None:
        """Show detailed platform + capabilities (p command)."""
        try:
            from core import platform as _plat
            from core import capabilities as _caps
            plat = _plat.get()
            caps = _caps.get()
        except Exception:
            self.console.print("[red]Platform detection unavailable[/red]")
            return

        table = Table(title="النظام / System", border_style="cyan")
        table.add_column("Key", style="bold")
        table.add_column("Value")
