# Device classification from discovery data
# ═══════════════════════════════════════════════════════
_DEVICE_HINTS = {
    "router":  ["internetgatewaydevice", "wanipconnection", "wancommoninterfaceconfig"],
    "printer": ["printer", "_printer", "_ipp", "_ipps", "brother", "hp-", "canon", "epson"],
    "tv":      ["mediarenderer", "mediaserver", "_googlecast", "_airplay"],
    "camera":  ["_camera", "hikvision", "dahua", "reolink"],
    "nas":     ["nas", "storage", "synology", "qnap"],
    "phone":   ["_raop", "_airplay", "_device-info", "iphone", "android"],
    "pc":      ["_smb", "_workstation", "_ssh", "windows"],
    "iot":     ["espressif", "tuya", "shelly", "sonoff"],
}


def classify_service_device(d: DiscoveredService) -> str:
    """Classify device by service/server/location strings."""
    haystack = " ".join([
        (d.service or "").lower(),
        (d.server or "").lower(),
        (d.location or "").lower(),
        (d.hostname or "").lower(),
    ])
    for dtype, hints in _DEVICE_HINTS.items():
        for hint in hints:
            if hint in haystack:
                return dtype
    return "unknown"


async def lan_discover_all(timeout: float = 4.0) -> list[DiscoveredService]:
    """Run all three protocols in parallel and merge results."""
    try:
        batches = await asyncio.gather(
            mdns_discover(timeout),
            ssdp_discover(timeout),
            netbios_discover(timeout),
            return_exceptions=True,
        )
    except Exception:
        return []

    merged: dict[str, DiscoveredService] = {}
    for batch in batches:
        if isinstance(batch, Exception) or not isinstance(batch, list):
            continue
        for d in batch:
            if d.ip not in merged:
                merged[d.ip] = d
                merged[d.ip].raw["sources"] = [d.source]
            else:
                cur = merged[d.ip]
                if not cur.hostname and d.hostname:
                    cur.hostname = d.hostname
                if not cur.server and d.server:
                    cur.server = d.server
                if not cur.service and d.service:
                    cur.service = d.service
                if d.source not in cur.raw.get("sources", []):
                    cur.raw.setdefault("sources", []).append(d.source)

    return list(merged.values())


def discover_sync(timeout: float = 4.0) -> list[dict[str, Any]]:
    """Synchronous wrapper for CLI/tests."""
    try:
        results = asyncio.run(lan_discover_all(timeout=timeout))
        out = []
        for r in results:
            d = r.to_dict()
            d["device_type"] = classify_service_device(r)
            out.append(d)
        return out
    except Exception:
        return []
